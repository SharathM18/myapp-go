# ============================================================
# Application
# ============================================================
MYAPP_PRIMARY__ENV=local

# ============================================================
# Background task
# ============================================================
MYAPP_TASK__CONCURRENCY=10

# ============================================================
# HTTP Server
# ============================================================
MYAPP_SERVER__PORT=8080
MYAPP_SERVER__READ_TIMEOUT=15s
MYAPP_SERVER__WRITE_TIMEOUT=15s
MYAPP_SERVER__IDLE_TIMEOUT=60s
MYAPP_SERVER__CORS_ALLOWED_ORIGINS=http://localhost:3000 # http://localhost:3000,http://localhost:4200

# ============================================================
# Database
# ============================================================
# example: postgresql://db_user:secret_pass@localhost:5432/my_app_db?sslmode=disable
MYAPP_DATABASE__DSN=postgres://postgres:postgres@localhost:5432/myapp?sslmode=disable
MYAPP_DATABASE__HOST=localhost
MYAPP_DATABASE__PORT=5432
MYAPP_DATABASE__USER=postgres
MYAPP_DATABASE__PASSWORD=secretpassword
MYAPP_DATABASE__NAME=myapp
MYAPP_DATABASE__SSL_MODE=disable
// DB Connection Pool
MYAPP_DATABASE__MAX_OPEN_CONNS=25
MYAPP_DATABASE__MAX_IDLE_CONNS=10
MYAPP_DATABASE__CONN_MAX_LIFETIME=30m
MYAPP_DATABASE__CONN_MAX_IDLE_TIME=5m

# ============================================================
# Redis Caching/ Redis Asynq Worker
# ============================================================
MYAPP_REDIS__ADDRESS=redis://localhost:6379
MYAPP_REDIS__PASSWORD=
MYAPP_REDIS__DATABASE=0

# ============================================================₹
# Authentication
# Example: openssl rand -base64 32
# ============================================================
MYAPP_AUTH__SECRET_KEY=super-secure-random-secret-key-that-is-at-least-32-chars-long

# ============================================================
# Email Integration
# ============================================================
MYAPP_INTEGRATION__EMAIL__API_KEY=

# ============================================================
# Observability
# ============================================================
MYAPP_OBSERVABILITY__LOGGING__LEVEL=info
MYAPP_OBSERVABILITY__LOGGING__FORMAT=json
MYAPP_OBSERVABILITY__LOGGING__SLOW_QUERY_THRESHOLD=100ms

MYAPP_OBSERVABILITY__OTEL__ENABLED=false
MYAPP_OBSERVABILITY__OTEL__TRACES_ENABLED=false
MYAPP_OBSERVABILITY__OTEL__METRICS_ENABLED=false
MYAPP_OBSERVABILITY__OTEL__LOGS_ENABLED=false
MYAPP_OBSERVABILITY__OTEL__SERVICE_NAME=myapp
MYAPP_OBSERVABILITY__OTEL__ENVIRONMENT=development
MYAPP_OBSERVABILITY__OTEL__ENDPOINT=http://localhost:4318
MYAPP_OBSERVABILITY__OTEL__PROTOCOL=http/protobuf
MYAPP_OBSERVABILITY__OTEL__EXPORT_TIMEOUT=10s
MYAPP_OBSERVABILITY__OTEL__BATCH_TIMEOUT=5s
MYAPP_OBSERVABILITY__OTEL__MAX_EXPORT_BATCH_SIZE=512
MYAPP_OBSERVABILITY__OTEL__MAX_QUEUE_SIZE=2048
MYAPP_OBSERVABILITY__OTEL__TRACES_SAMPLING_RATIO=1.0

# Not yet used, but validation applied
MYAPP_OBSERVABILITY__HEALTH_CHECKS__ENABLED=true---
MYAPP_OBSERVABILITY__HEALTH_CHECKS__INTERVAL=30s---
MYAPP_OBSERVABILITY__HEALTH_CHECKS__TIMEOUT=5s---
MYAPP_OBSERVABILITY__HEALTH_CHECKS__CHECKS=database,redis---
