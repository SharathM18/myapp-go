# ============================================================
# Application
# ============================================================
MYAPP_PRIMARY__ENV=local
MYAPP_PRIMARY__SERVICE_NAME=myapp

# ============================================================
# App HTTP Server (Public facing)
# ============================================================
MYAPP_APP_SERVER__PORT=8080
# Local: 15s | Prod: 10s-15s (Keep slightly longer than your longest expected DB query)
MYAPP_APP_SERVER__READ_TIMEOUT=15s
MYAPP_APP_SERVER__WRITE_TIMEOUT=15s
# Local: 60s | Prod: 120s (Should be longer than your Load Balancer's idle timeout to prevent dropped connections)
MYAPP_APP_SERVER__IDLE_TIMEOUT=60s
# Local: http://localhost:3000 | Prod: https://www.yourdomain.com,https://app.yourdomain.com
MYAPP_APP_SERVER__CORS_ALLOWED_ORIGINS=http://localhost:3000 # http://localhost:3000,http://localhost:4200

# ============================================================
# System HTTP Server (Internal DevOps/Infrastructure)
# ============================================================
MYAPP_SYSTEM_SERVER__PORT=9090
# Internal connections are fast; keep timeouts tight to free up resources
MYAPP_SYSTEM_SERVER__READ_TIMEOUT=5s
MYAPP_SYSTEM_SERVER__WRITE_TIMEOUT=5s
MYAPP_SYSTEM_SERVER__IDLE_TIMEOUT=30s
# Note: No CORS needed for Management Server because browsers don't query it directly via AJAX.

# ============================================================
# Database
# ============================================================
# example: postgresql://db_user:password@host:port/db_name?sslmode=disable
# export MYAPP_DATABASE__DSN=postgres://postgres:postgres@localhost:5432/myapp?sslmode=disable
MYAPP_DATABASE__HOST=localhost
MYAPP_DATABASE__PORT=5432
MYAPP_DATABASE__USER=postgres
MYAPP_DATABASE__PASSWORD=secretpassword
MYAPP_DATABASE__NAME=myapp
# Local: disable | Prod: require (or verify-full for strict CA verification)
MYAPP_DATABASE__SSL_MODE=disable

// DB Connection Pool
# Local: 25 | Prod: 50-200 (Depends on your RDS instance RAM. Too high causes DB CPU thrashing)
MYAPP_DATABASE__MAX_OPEN_CONNS=25
# Local: 10 | Prod: 25-50 (Keep idle conns ready to handle sudden traffic spikes instantly)
MYAPP_DATABASE__MAX_IDLE_CONNS=10
MYAPP_DATABASE__CONN_MAX_LIFETIME=30m
# Prod: 5m (Kills connections sitting idle too long to free up DB memory)
MYAPP_DATABASE__CONN_MAX_IDLE_TIME=5m

# ============================================================
# Redis Caching/ Redis Asynq Worker
# ============================================================
MYAPP_REDIS_CACHE__ADDRESS=localhost:6379
MYAPP_REDIS_CACHE__PASSWORD=
MYAPP_REDIS_CACHE__DATABASE=0
MYAPP_REDIS_CACHE__POOL_SIZE=10
MYAPP_REDIS_CACHE__MIN_IDLE_CONNS=2

MYAPP_REDIS_ASYNQ__ADDRESS=localhost:6379
MYAPP_REDIS_ASYNQ__PASSWORD=
MYAPP_REDIS_ASYNQ__DATABASE=1
# Asynq manages its own pool internally, so we just need the connection details

# ============================================================
# Background task
# ============================================================
# Local: 10 | Prod: 50-200 (Rule of thumb: 10 * Number of CPU cores on the worker server)
MYAPP_WORKER__CONCURRENCY=10

# ============================================================₹
# Authentication
# Example: openssl rand -base64 32
# ============================================================
MYAPP_AUTH__SECRET_KEY=super-secure-random-secret-key-that-is-at-least-32-chars-long

# ============================================================
# External integration configs
# ============================================================
# Email
MYAPP_INTEGRATION__EMAIL__API_KEY=

# ============================================================
# Observability configs
# ============================================================
# Logging
# Local: debug/info | Prod: info (Never use debug in prod, it generates massive log volume)
MYAPP_OBSERVABILITY__LOGGING__LEVEL=info
# Local: console | Prod: json (JSON is mandatory for Datadog/ELK to parse logs correctly)
MYAPP_OBSERVABILITY__LOGGING__FORMAT=json
MYAPP_OBSERVABILITY__LOGGING__SLOW_QUERY_THRESHOLD=100ms

# OTel
# Local: false | Prod: true (Enable only in prod or staging to avoid sending local junk to Datadog)
MYAPP_OBSERVABILITY__OTEL__ENABLED=false
MYAPP_OBSERVABILITY__OTEL__TRACES_ENABLED=false
MYAPP_OBSERVABILITY__OTEL__METRICS_ENABLED=false
MYAPP_OBSERVABILITY__OTEL__LOGS_ENABLED=false
MYAPP_OBSERVABILITY__OTEL__SERVICE_NAME=myapp
MYAPP_OBSERVABILITY__OTEL__ENVIRONMENT=development
# Local: http://localhost:4318 | Prod: Datadog/Jaeger Agent IP (e.g., http://otel-collector:4318)
MYAPP_OBSERVABILITY__OTEL__ENDPOINT=http://localhost:4318
# Prod: grpc is preferred for production performance, http/protobuf is fine for sidecars
MYAPP_OBSERVABILITY__OTEL__PROTOCOL=http/protobuf

# Batching & Export Configuration
MYAPP_OBSERVABILITY__OTEL__EXPORT_TIMEOUT=10s
MYAPP_OBSERVABILITY__OTEL__BATCH_TIMEOUT=5s
MYAPP_OBSERVABILITY__OTEL__MAX_EXPORT_BATCH_SIZE=512
MYAPP_OBSERVABILITY__OTEL__MAX_QUEUE_SIZE=2048

# Sampling
# Local: 1.0 (100% traces) | Prod: 0.1 to 0.2 (10% to 20% traces).
# Setting this to 1.0 in a high-traffic production app will result in higger Datadog/NewRelic bills.
MYAPP_OBSERVABILITY__OTEL__TRACES_SAMPLING_RATIO=1.0
